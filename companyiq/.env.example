# ============================================================
# CompanyIQ — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit the .env file to version control
# ============================================================

# ---- Application ----
APP_NAME=CompanyIQ
APP_ENV=development          # development | staging | production
SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Database ----
DATABASE_URL=postgresql://companyiq:companyiq_pass@localhost:5432/companyiq
# For Docker: DATABASE_URL=postgresql://companyiq:companyiq_pass@postgres:5432/companyiq

# ---- Vector Database ----
VECTOR_DB_TYPE=chroma        # chroma | faiss | pinecone
VECTOR_DB_PATH=./chroma_db   # local path for ChromaDB
# PINECONE_API_KEY=           # if using Pinecone

# ---- LLM Provider ----
LLM_PROVIDER=openai          # openai | gemini | local
LLM_API_KEY=your-openai-api-key-here
MODEL_NAME=gpt-4o-mini       # gpt-4o | gpt-4o-mini | gemini-1.5-pro
EMBEDDING_MODEL=text-embedding-3-small
MAX_TOKENS=4096
TEMPERATURE=0.2

# If using Gemini instead:
# LLM_PROVIDER=gemini
# LLM_API_KEY=your-gemini-api-key
# MODEL_NAME=gemini-1.5-pro

# ---- Demo Mode (no LLM key needed) ----
DEMO_MODE=false              # true = use synthetic demo data, no LLM calls

# ---- File Upload ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ---- Chunking ----
CHUNK_SIZE=512               # tokens per chunk
CHUNK_OVERLAP=64             # overlap tokens

# ---- Retrieval ----
TOP_K_CHUNKS=10              # number of chunks to retrieve
HYBRID_ALPHA=0.7             # 1.0 = pure semantic, 0.0 = pure keyword

# ---- CORS ----
FRONTEND_URL=http://localhost:5173

# ---- Logging ----
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ---- Rate Limiting ----
RATE_LIMIT_PER_MINUTE=60

# ---- Opportunity Scoring Weights (must sum to 1.0) ----
SCORE_WEIGHT_BUSINESS_RELEVANCE=0.30
SCORE_WEIGHT_RECENT_ACTIVITY=0.25
SCORE_WEIGHT_PRODUCT_FIT=0.20
SCORE_WEIGHT_HISTORICAL_SIMILARITY=0.15
SCORE_WEIGHT_EVIDENCE_CONFIDENCE=0.10
