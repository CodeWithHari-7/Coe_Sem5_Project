nosetests.xml
coverage.xml
*.cover

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Node.js / Frontend
companyiq/frontend/node_modules/
companyiq/frontend/dist/
companyiq/frontend/.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database files
*.db
*.sqlite
*.sqlite3

# ChromaDB / Vector store data
companyiq/backend/chroma_db/

# Uploads (user-uploaded files)
companyiq/uploads/
companyiq/backend/uploads/

# Docker
*.log

# Build artifacts
*.pyc
*.pyo

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

